# ─────────────────────────────────────────────────────────────
# KENT360 – environment template
# Copy to .env (Copy-Item .env.example .env) and adjust.
# Never commit real secrets. Values below are for local development only.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# ── PostgreSQL + PostGIS (docker compose) ────────────────────
POSTGRES_USER=kent360
POSTGRES_PASSWORD=kent360_dev_password
POSTGRES_DB=kent360
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kent360:kent360_dev_password@localhost:5432/kent360?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── Object storage (MinIO in dev, any S3-compatible store in prod) ──
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=kent360
MINIO_SECRET_KEY=kent360_dev_secret
MINIO_BUCKET=kent360-media
# Browser-facing MinIO URL for presigned links (defaults to MINIO_ENDPOINT)
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Development/demo only: accept field steps without the on-site distance check
# (recorded in the work order timeline). The API refuses to start with it in production.
FIELD_LOCATION_BYPASS=false
MEDIA_URL_TTL_SECONDS=300

# ── Auth ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-access-token-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-token-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Secure flag of the refresh cookie (defaults to true when NODE_ENV=production)
# AUTH_COOKIE_SECURE=false

# ── AI ───────────────────────────────────────────────────────
# mock = works offline with deterministic, explainable results
# mock (default, no key) | anthropic (Claude; falls back to mock without a key or on errors)
AI_PROVIDER=mock
AI_API_KEY=
# AI_MODEL=claude-opus-5
# AI_TIMEOUT_MS=15000

# ── Web (Next.js reads NEXT_PUBLIC_* from apps/web/.env.local) ──
NEXT_PUBLIC_API_URL=http://localhost:4000
