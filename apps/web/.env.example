# Copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:4000

# Fallback branding shown before the municipality profile is loaded from the API.
# Real tenant branding (name, logo, colours) lives in the municipalities table.
NEXT_PUBLIC_DEFAULT_MUNICIPALITY_NAME=KENT360 Demo Belediyesi

# MapLibre style for the live map (default: OpenFreeMap positron – free, no API key).
# An empty value disables the base map and shows a configuration notice.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
