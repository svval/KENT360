{
  "name": "kent360",
  "version": "0.1.0",
  "private": true,
  "description": "KENT360 – Smart Municipal Operations & Urban Intelligence Platform",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/config",
    "packages/shared-types",
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "postinstall": "npm run build -w @kent360/shared-types",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @kent360/api\" \"npm run dev -w @kent360/web\"",
    "dev:api": "npm run dev -w @kent360/api",
    "dev:web": "npm run dev -w @kent360/web",
    "build": "npm run build -w @kent360/shared-types && npm run build -w @kent360/api && npm run build -w @kent360/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "db:generate": "npm run db:generate -w @kent360/api",
    "db:migrate": "npm run db:migrate -w @kent360/api",
    "db:deploy": "npm run db:deploy -w @kent360/api",
    "db:seed": "npm run db:seed -w @kent360/api",
    "db:studio": "npm run db:studio -w @kent360/api",
    "demo:refresh": "npm run demo:refresh -w @kent360/api --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@parcel/watcher@2.6.0": true,
    "argon2@0.45.1": true
  }
}
